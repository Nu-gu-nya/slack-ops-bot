# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 커밋하지 않는다.
# Copy this file to .env and fill in the values. .env is never committed.

# --- Slack ---
# Bot User OAuth Token: api.slack.com/apps → Install App
SLACK_BOT_TOKEN=xoxb-
# App-Level Token (Socket Mode 접속용, connections:write 스코프)
SLACK_APP_TOKEN=xapp-
# 실패·경고 알림을 받을 관리자 채널 ID (C로 시작). 봇을 초대해 둔다
ADMIN_CHANNEL_ID=

# --- Google Sheets (A봇) ---
# 서비스 계정 JSON 키의 client_email
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# JSON 키의 private_key 값을 큰따옴표로 감싸 그대로 붙여넣는다 (\n 포함, 한 줄)
GOOGLE_PRIVATE_KEY=
# 시트 URL의 /d/ 와 /edit 사이 문자열
GOOGLE_SHEET_ID=
# (선택) 출근 알림 스케줄. 기본값은 평일 08:50 (Asia/Seoul). 테스트 시 "*/2 * * * *" 등으로 앞당긴다
# ATTENDANCE_CRON=

# --- Claude (B봇) ---
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# 업무 보고 다이제스트를 받을 매니저 채널 ID. 봇을 초대해 둔다
REPORT_CHANNEL_ID=
