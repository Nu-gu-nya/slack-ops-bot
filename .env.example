# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 커밋하지 않는다.
# Copy this file to .env and fill in the values. .env is never committed.

# --- Slack (현재 단계에서 필수) ---
# Bot User OAuth Token: api.slack.com/apps → Install App
SLACK_BOT_TOKEN=xoxb-
# App-Level Token (Socket Mode 접속용, connections:write 스코프)
SLACK_APP_TOKEN=xapp-

# --- 이후 단계에서 사용 (A봇 시트 연동 / B봇 요약) ---
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY=
# GOOGLE_SHEET_ID=
# ANTHROPIC_API_KEY=
