{
  "name": "slack-ops-bot",
  "version": "1.0.0",
  "description": "Slack bots that automate daily attendance check-ins and work-report digests (Google Sheets, Claude API).",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/bot/app.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/bot/app.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.spec.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": true,
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@googleapis/sheets": "^18.1.1",
    "@slack/bolt": "^5.1.0",
    "node-cron": "^4.6.0"
  }
}
