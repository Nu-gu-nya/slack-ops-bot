{
  "name": "slack-ops-bot",
  "version": "1.0.0",
  "description": "Slack bots that automate daily attendance check-ins and work-report digests (Google Sheets, Claude API).",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/bot/app.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/bot/app.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.spec.ts\"",
    "lint": "eslint ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "eslint": "^10.13.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@googleapis/sheets": "^18.1.1",
    "@slack/bolt": "^5.1.0",
    "node-cron": "^4.6.0"
  }
}
